# WalletConnect / Reown Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Solana RPC
NEXT_PUBLIC_SOLANA_RPC_URL=

# 앱 공개 URL (배포 후)
# NEXT_PUBLIC_APP_URL=https://stamp.yourdomain.com
NEXT_PUBLIC_APP_URL=

# 미디어 CDN (R2 public 또는 custom domain) — 온체인 tokenURI/image
# MEDIA_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# 또는 MEDIA_PUBLIC_BASE_URL=https://media.yourdomain.com
MEDIA_PUBLIC_BASE_URL=

# Cloudflare R2 (S3 호환)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# 검증: npm run media:check -- --probe
